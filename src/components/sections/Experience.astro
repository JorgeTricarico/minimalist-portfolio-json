---
import Section from "../Section.astro"
import { ui } from "@/i18n"
import { work as defaultWork } from "@cv"
import type { Work } from "@/cv"

interface Props {
  work?: Array<Work>
  lang?: string
}

const { work = defaultWork, lang = 'es' } = Astro.props
const t = ui[lang as keyof typeof ui]

interface PositionItem {
  position: string
  startDate: string
  endDate: string | null
  summary?: string
  highlights?: string[]
  startYear: number
  endYear: number | string
  duration: string
}

interface CompanyExperience {
  name: string
  url?: string
  startDate: string
  endDate: string | null
  startYear: number
  endYear: number | string
  duration: string
  positions: PositionItem[]
}

function calculateDuration(startDateStr: string, endDateStr: string | null, translations: Record<string, string>): string {
  const start = new Date(startDateStr)
  const end = endDateStr != null && !isNaN(Date.parse(endDateStr)) ? new Date(endDateStr) : new Date()
  const totalMonths = (end.getFullYear() - start.getFullYear()) * 12 + (end.getMonth() - start.getMonth())
  const years = Math.floor(totalMonths / 12)
  const months = totalMonths % 12

  return [
    years > 0 ? `${years} ${years > 1 ? translations['experience.years'] : translations['experience.year']}` : '',
    months > 0 ? `${months} ${months > 1 ? translations['experience.months'] : translations['experience.month']}` : ''
  ].filter(Boolean).join(' ').trim()
}

function getYearRange(startDateStr: string, endDateStr: string | null, translations: Record<string, string>) {
  const startYear = new Date(startDateStr).getFullYear()
  const endYear =
    endDateStr != null ? (isNaN(Date.parse(endDateStr)) ? endDateStr : new Date(endDateStr).getFullYear()) : translations['experience.actual']
  return { startYear, endYear }
}

const groupedExperiences = (work || []).reduce<CompanyExperience[]>((acc, item) => {
  const itemYears = getYearRange(item.startDate, item.endDate, t)
  const itemDuration = calculateDuration(item.startDate, item.endDate, t)

  const pos: PositionItem = {
    position: item.position,
    startDate: item.startDate,
    endDate: item.endDate,
    summary: item.summary,
    highlights: item.highlights,
    startYear: itemYears.startYear,
    endYear: itemYears.endYear,
    duration: itemDuration
  }

  const prev = acc[acc.length - 1]
  const isSameCompany = prev && prev.name.trim().toLowerCase() === item.name.trim().toLowerCase()

  if (isSameCompany) {
    prev.positions.push(pos)
    if (!prev.url && item.url) prev.url = item.url
    if (new Date(item.startDate) < new Date(prev.startDate)) {
      prev.startDate = item.startDate
    }
    if (prev.endDate === null || item.endDate === null) {
      prev.endDate = null
    } else if (new Date(item.endDate) > new Date(prev.endDate)) {
      prev.endDate = item.endDate
    }
  } else {
    acc.push({
      name: item.name,
      url: item.url,
      startDate: item.startDate,
      endDate: item.endDate,
      startYear: itemYears.startYear,
      endYear: itemYears.endYear,
      duration: itemDuration,
      positions: [pos]
    })
  }
  return acc
}, [])

for (const company of groupedExperiences) {
  if (company.positions.length > 1) {
    const years = getYearRange(company.startDate, company.endDate, t)
    company.startYear = years.startYear
    company.endYear = years.endYear
    company.duration = calculateDuration(company.startDate, company.endDate, t)
  }
}
---

<Section title={t['section.experience']}>
  <ul>
    {
      groupedExperiences.map((company) => {
        const isMulti = company.positions.length > 1
        const mainPos = company.positions[0]

        return (
          <li>
            <article>
              <details>
                <summary>
                  <header>
                    <div>
                      <div class="title-container">
                        <h3>
                          {company.url ? (
                            <a href={company.url} title={`Ver ${company.name}`} target="_blank">
                              {company.name}
                            </a>
                          ) : (
                            company.name
                          )}
                        </h3>
                        <svg class="chevron-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      </div>

                      {isMulti ? (
                        <div class="multi-role-subtitle">
                          <h4>
                            {mainPos.position}
                            <span class="promotion-pill">
                              {lang === 'es' ? 'Ascenso' : 'Promotion'} · {company.positions.length} {lang === 'es' ? 'puestos' : 'roles'}
                            </span>
                          </h4>
                        </div>
                      ) : (
                        <h4>{mainPos.position}</h4>
                      )}
                    </div>

                    <div>
                      <time datetime={company.startDate} data-title={company.startDate}>
                        {company.startYear}
                      </time>
                      {" - "}
                      <time datetime={company.endDate ?? ''} data-title={company.endDate}>
                        {company.endYear}
                      </time>
                    </div>
                  </header>
                  <span class="duration">{company.duration}</span>
                </summary>

                <footer>
                  {!isMulti ? (
                    <>
                      {mainPos.summary && <p set:html={mainPos.summary}></p>}
                      {mainPos.highlights && (
                        <ul>
                          {mainPos.highlights.map((highlight) => (
                            <li set:html={highlight.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></li>
                          ))}
                        </ul>
                      )}
                    </>
                  ) : (
                    <div class="roles-timeline">
                      {company.positions.map((pos) => (
                        <div class="timeline-step">
                          <div class="timeline-dot" aria-hidden="true"></div>
                          <div class="timeline-content">
                            <div class="role-header">
                              <h5 class="role-title">{pos.position}</h5>
                              <div class="role-dates">
                                <time datetime={pos.startDate} data-title={pos.startDate}>
                                  {pos.startYear}
                                </time>
                                {" - "}
                                <time datetime={pos.endDate ?? ''} data-title={pos.endDate}>
                                  {pos.endYear}
                                </time>
                                <span class="role-duration">({pos.duration})</span>
                              </div>
                            </div>

                            {pos.summary && <p set:html={pos.summary}></p>}
                            {pos.highlights && (
                              <ul>
                                {pos.highlights.map((highlight) => (
                                  <li set:html={highlight.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></li>
                                ))}
                              </ul>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </footer>
              </details>
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  summary {
    list-style: none;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.2s ease;
    padding: 12px;
    margin: -12px;
    border-radius: 12px;
    position: relative;
  }

  summary:hover {
    background: rgba(0, 0, 0, 0.02);
  }

  :global(.dark) summary:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  summary:active {
    transform: scale(0.995);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .title-container {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .chevron-icon {
    color: var(--text-muted);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.6;
    animation: entrance 0.8s ease-out backwards;
    animation-delay: 0.5s;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
    padding: 2px;
    min-width: 20px;
    min-height: 20px;
  }

  :global(.dark) .chevron-icon {
    background: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.9);
  }

  @keyframes entrance {
    from { opacity: 0; transform: scale(0.5) rotate(-90deg); }
    to { opacity: 0.6; transform: scale(1) rotate(0deg); }
  }

  details[open] .chevron-icon {
    transform: rotate(180deg);
    opacity: 0.8;
    color: var(--text-main);
  }

  @media (hover: none) {
    .chevron-icon {
      animation: nudge 3s infinite ease-in-out;
    }
  }

  summary:hover .chevron-icon {
    opacity: 0.9;
    color: var(--text-main);
    animation: bounce 0.6s infinite alternate ease-in-out;
  }

  details[open] summary:hover .chevron-icon {
    animation: bounceOpen 0.6s infinite alternate ease-in-out;
  }

  @keyframes nudge {
    0%, 80%, 100% { transform: translateY(0); }
    85% { transform: translateY(4px); }
    90% { transform: translateY(0); }
    95% { transform: translateY(4px); }
  }

  @keyframes bounce {
    from { transform: translateY(0); }
    to { transform: translateY(3px); }
  }

  @keyframes bounceOpen {
    from { transform: rotate(180deg) translateY(0); }
    to { transform: rotate(180deg) translateY(-3px); }
  }

  footer {
    padding-top: 12px;
    color: var(--text-muted);
    font-size: 0.9rem;
    animation: slideDown 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes slideDown {
    from { 
      opacity: 0; 
      transform: translateY(-8px);
    }
    to { 
      opacity: 1; 
      transform: translateY(0);
    }
  }

  footer ul {
    list-style-type: disc;
    padding-left: 20px;
    gap: 8px;
  }

  .duration {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 2px;
    display: block;
    opacity: 0.8;
  }

  article h3 {
    font-weight: 500;
    color: var(--text-main);
  }

  article a {
    color: var(--text-main);
  }

  article a:hover {
    text-decoration: underline;
  }

  article h4 {
    color: var(--text-main);
    font-weight: 400;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: var(--text-muted);
    font-size: 0.85rem;
    min-width: 102px;
    cursor: default;
  }

  [data-title]:hover:after {
    opacity: 1;
    transition: all 0.1s ease-in-out 0.5s;
    visibility: visible;
  }

  [data-title]:after {
    content: attr(data-title);
    background-color: #333;
    color: #fff;
    font-size: .75rem;
    font-family: Menlo, Monaco, Lucida Console, "Courier New", monospace;
    position: absolute;
    padding: .2rem .5rem;
    bottom: -1.4rem;
    left: 50%;
    white-space: nowrap;
    box-shadow: 1px 1px 1px #222222;
    opacity: 0;
    border: 1px solid #111111;
    z-index: 99999;
    visibility: hidden;
    border-radius: 6px;
  }

  [data-title] {
    position: relative;
  }

  /* --- Timeline / Ascensos --- */
  .promotion-pill {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: 9999px;
    background: rgba(var(--accent-color, 96, 165, 250), 0.12);
    color: var(--accent-color, #3b82f6);
    border: 1px solid rgba(var(--accent-color, 96, 165, 250), 0.25);
    vertical-align: middle;
  }

  :global(.dark) .promotion-pill {
    background: rgba(96, 165, 250, 0.15);
    color: #93c5fd;
    border-color: rgba(96, 165, 250, 0.3);
  }

  .roles-timeline {
    position: relative;
    padding-left: 18px;
    margin-left: 6px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .roles-timeline::before {
    content: "";
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 4px;
    width: 2px;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 2px;
  }

  :global(.dark) .roles-timeline::before {
    background: rgba(255, 255, 255, 0.15);
  }

  .timeline-step {
    position: relative;
  }

  .timeline-dot {
    position: absolute;
    left: -18px;
    top: 5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--text-muted);
    border: 2px solid var(--bg-page-center, #fff);
    transition: background 0.3s ease;
  }

  .timeline-step:first-child .timeline-dot {
    background: var(--accent-color, #2563eb);
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
  }

  :global(.dark) .timeline-step:first-child .timeline-dot {
    background: #60a5fa;
    box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.25);
    border-color: #121212;
  }

  .role-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 6px;
    gap: 8px;
  }

  .role-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
    margin: 0;
  }

  .role-dates {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .role-duration {
    font-size: 0.75rem;
    opacity: 0.85;
    margin-left: 4px;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }

    .role-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }

    .roles-timeline {
      padding-left: 14px;
      margin-left: 4px;
    }

    .timeline-dot {
      left: -14px;
    }
  }

  @media print {
    .chevron-icon {
      display: none;
    }
    details {
      display: block !important;
    }
    details > footer {
      display: block !important;
    }
    ul {
      gap: 12px !important;
    }
    footer {
      padding-top: 4px !important;
      animation: none !important;
    }
    .roles-timeline::before {
      background: #ccc !important;
    }
    .timeline-dot {
      background: #444 !important;
      border-color: #fff !important;
    }
  }
</style>
