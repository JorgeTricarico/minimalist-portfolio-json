# ── Configuración de Analítica Avanzada & Notificaciones (Opcional) ──────────

# PostHog Analytics & Session Replay (100% Free: 1M eventos y 5.000 grabaciones/mes)
# Obtén tu clave pública en: https://us.i.posthog.com/settings/project
PUBLIC_POSTHOG_KEY=

# Alertas en Tiempo Real a Telegram (Opcional)
# 1. Crea un bot con @BotFather para obtener el token
# 2. Obtén tu Chat ID con @userinfobot
PUBLIC_TELEGRAM_BOT_TOKEN=
PUBLIC_TELEGRAM_CHAT_ID=

# Alertas en Tiempo Real a Discord (Opcional)
# Pega la URL del Webhook del canal de Discord
PUBLIC_DISCORD_WEBHOOK=
